# herdr-zsa-lights settings: copy to
# `$(herdr plugin config-dir jwarykowski.herdr-zsa-lights)/config.env`
# and keep only what you change. Run the restart action afterwards.

# keyboard model, a file in maps/: moonlander, voyager
HERDR_ZSA_MODEL=moonlander

# colours
HERDR_ZSA_BLOCKED="#ff8800"
HERDR_ZSA_DONE="#00cc44"

# seconds between polls of herdr
HERDR_ZSA_INTERVAL=2

# herdr-pomodoro bar: work and break colours
HERDR_ZSA_POMODORO_WORK="#cc0000"
HERDR_ZSA_POMODORO_BREAK="#0066ff"

# music bars: the keybars command and any extra flags (see keybars -h)
HERDR_ZSA_KEYBARS=keybars
HERDR_ZSA_KEYBARS_ARGS=""

# party: length in seconds, and the colours it cycles through
HERDR_ZSA_PARTY_SECONDS=4
HERDR_ZSA_PARTY_COLOURS="#ff0000 #ff8800 #ffee00 #00cc44 #00ccff #0044ff #aa00ff #ff00aa"

# override the model's key indices (Keymapp's order): keys 1-9, and the
# top-right key
# HERDR_ZSA_NUMBER_LEDS="1 2 3 4 5 37 38 39 40"
# HERDR_ZSA_JUMP_LED=42
# the pomodoro bar's keys, Q-P by default; empty turns the bar off
# HERDR_ZSA_POMODORO_LEDS="8 9 10 11 12 44 45 46 47 48"
