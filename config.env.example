# herdr-zsa-lights settings: copy to
# `$(herdr plugin config-dir jwarykowski.herdr-zsa-lights)/config.env`
# and keep only what you change. Run the restart action afterwards.

# keyboard model, a file in maps/: moonlander, voyager
HERDR_ZSA_MODEL=moonlander

# colours
HERDR_ZSA_BLOCKED="#ff8800"
HERDR_ZSA_DONE="#00cc44"

# seconds between polls of herdr
HERDR_ZSA_INTERVAL=2

# override the model's LED indices: keys 1-9, and the top-right key
# HERDR_ZSA_NUMBER_LEDS="5 10 15 20 25 61 56 51 46"
# HERDR_ZSA_JUMP_LED=36
