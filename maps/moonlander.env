# ZSA Moonlander: Keymapp's key indices. Keymapp numbers each half on its own,
# left 0-35 then right 36-71, row by row from the left including the inner
# column (not the firmware's rgb_matrix LED order).
NUMBER_LEDS="1 2 3 4 5 37 38 39 40"      # keys 1-9
JUMP_LED=42                              # top-right key
POMODORO_LEDS="8 9 10 11 12 44 45 46 47 48" # Q-P
